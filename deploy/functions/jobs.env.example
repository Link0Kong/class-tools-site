# /etc/class-tools/jobs.env 模板（**只有占位符，不要填真实值后提交**）
#
# 真实文件由 `python deploy\ecs_cron.py install` 从本机 secrets 生成：
#   - 权限 600 root:root，不打印、不入库、不进 git；
#   - 内容随 --backend 变化（staging 默认 / live 需 --allow-live）。
# 本文件仅用于说明键名与格式；`deploy/functions/README.md` 有完整说明。

# ---- 目标后端（staging 影子库；切流后改成 live：/v1/rdb/rest/）----
CB_BASE=http://121.196.47.2/v1/rdb/rest-next/
CB_KEY=<publishable-key，自建后端由 Caddy 剥离 Authorization，占位即可>
CLASS_CB_BASE=http://121.196.47.2/v1/rdb/rest-next/
CLASS_CB_KEY=<同 CB_KEY>

# ---- 管理员凭据（生产服务凭据，仅脚本内部 class_verify 使用）----
CLASS_ADMIN_SID=<管理员学号>
CLASS_ADMIN_NAME=<管理员姓名>
#CLASS_TOKEN=<可选：固定 token；设置后不再 class_verify>

# ---- 学工记（仅 xgj_sync 需要）----
XGJ_TOKEN=<小管家 token>
XGJ_MEMBER_ID=<member_id>
XGJ_EXP=0
XGJ_EXP_TEXT=
XGJ_CID=

# ---- 心跳 / 巡检标记（ecs_cron.py 固定写入）----
CLASS_JOB_HEARTBEAT=1
CLASS_JOBS_STATE=/var/lib/class-tools/jobs/state
CLASS_HEALTH_RUNNER=ecs-timer
